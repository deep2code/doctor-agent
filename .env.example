# ============================================================
# doctor-agent 配置示例
# 复制为 .env 后按需修改（loadDotenv 自动加载）
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# 默认使用 DeepSeek（国内模型）
# 可选: deepseek（默认）| openai-compat（智谱/豆包/Qwen 等国内 OpenAI 兼容端点）| anthropic
LLM_PROVIDER=deepseek

# Anthropic（LLM_PROVIDER=anthropic 时必填）
# 只有这个 provider 支持提示词前缀缓存（静态 8 层打 cache_control 断点）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek API Key（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
# 带图请求路由到视觉模型(DeepSeek 主线文本模型不收图);默认与 DEEPSEEK_MODEL 同为 deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# ── OpenAI 兼容端点（国内服务: 智谱 Zhipu / 豆包 / Qwen / SiliconFlow）──
# 使用 LLM_PROVIDER=openai-compat 时启用
# OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # Zhipu 智谱
# OPENAI_COMPAT_API_KEY=your_key
# OPENAI_COMPAT_MODEL=glm-4-flash
# 带图请求的视觉模型（留空 = 用 OPENAI_COMPAT_MODEL 本身收图）
# OPENAI_COMPAT_VISION_MODEL=

# 豆包(Doubao/火山方舟)OpenAI 兼容接入; LLM_PROVIDER=openai-compat
# 1) 火山方舟控制台开通豆包模型 -> API Key 管理 复制密钥
# 2) 填下面三项（model 可直接用模型名，如 doubao-seed-2-1-pro-260628；
#    也可用推理接入点 ID，形如 ep-2024xxxx）
# ── 普通按量付费 ──
# OPENAI_COMPAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_COMPAT_API_KEY=your_ark_key
# OPENAI_COMPAT_MODEL=doubao-seed-2-1-pro-260628
#
# ── 火山方舟 Coding Plan / Agent Plan 订阅套餐 ──
# 兼容 OpenAI 协议, 用套餐专属 Base URL（注意不是普通 /api/v3）+ 套餐 API Key:
#   Coding Plan:  https://ark.cn-beijing.volces.com/api/coding/v3
#                 model 可填别名 ark-code-latest（控制台切实际模型, 3-5 分钟生效）
#                 或具体名: Doubao-Seed-2.0-Code / Kimi-K2.5 / GLM-4.7 / DeepSeek-V3.2
#   Agent Plan:   同样 OpenAI 兼容, 用企业版专属 Base URL + API Key（控制台获取）
# 参考: https://www.volcengine.com/docs/82379/2160841
# ⚠️ 注意: 1) app 重度依赖 tool calling + SSE 流式, 接入前先小流量验证
#          2) 套餐定位是 coding/agent 工具订阅, 线上业务量级请确认套餐限流条款
# OPENAI_COMPAT_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# OPENAI_COMPAT_API_KEY=your_coding_plan_key
# OPENAI_COMPAT_MODEL=ark-code-latest

# ── Agent settings ───────────────────────────────────────────
MAX_TOKENS=4096
TEMPERATURE=0.3
MAX_HISTORY_TURNS=20
# 一轮回答里 agent loop 最多迭代几轮（工具往返次数上限）；默认 5
MAX_TOOL_ITERATIONS=5
# 一轮回答里最多执行多少个工具调用（含重复计数）；默认 5
MAX_TOOL_CALLS=5

# Knowledge retrieval
KNOWLEDGE_TOP_K=5
KNOWLEDGE_RETRIEVAL_ENABLED=true

# ── Query understanding（查询理解, 默认开启）──
# 仅当逐字召回不足 topK 时才触发（不在首 token 路径上白付一次 LLM 调用），
# 8 秒超时后静默退化为"只用原句检索"。
QUERY_UNDERSTANDING_ENABLED=true
# 一次最多派生几条分支查询；默认 5
QUERY_UNDERSTANDING_BRANCHES=5
# 专门的改写模型（走 OPENAI_COMPAT_* 端点）；留空 = 用主模型
UNDERSTAND_MODEL=

# 口语↔规范术语同义词表的外挂文件（内置表是 //go:embed 的 alias_map.json，永远生效）。
# 默认路径 data/alias_map.json 在仓库里并不存在，所以启动会打一条 warn 并只用内置表；
# 想外挂自己的一份就把文件放到这个路径。
ALIAS_MAP_PATH=data/alias_map.json
# 上传图片的落盘目录（/media/* 由它提供）
MEDIA_DIR=data/media

# ── Vector retrieval (default ON; graceful fallback to keyword) ──
# Hybrid retrieval = keyword + vector (RRF fusion). Both default ON.
# When Qdrant is unreachable OR no vectors are indexed yet, retrieval
# automatically degrades to keyword-only (no error).
# Run `go run ./cmd/vector-bake` once to bake gz knowledge into Qdrant
# (offline; also what the qdrant data image does at build time).
VECTOR_STORE_ENABLED=true
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6334
VECTOR_COLLECTION=medical_knowledge

# Docker Compose: RAG image = pure gz knowledge + Qdrant + baked vectors.
# Override to point at your own registry after rebuilding with
#   python3 external/make_gz.py && ./build.sh qdrant     (single packaging entry: ./build.sh)
# QDRANT_IMAGE=doctor-agent-qdrant:latest

# Embedding provider (REQUIRED for semantic retrieval): must be the SAME
# model the Qdrant vectors were baked with (bge-m3). No offline fallback —
# an empty EMBEDDING_BASE_URL disables the vector leg (agent falls back to
# keyword-only with a warning; sync-knowledge / vector-bake refuse to run).
#
# ── Option A: Ollama local (Apple Silicon / GPU, zero cost, offline) ──
# Install Ollama (https://ollama.com), then:
#   ollama pull bge-m3
#   ollama serve   # default: http://localhost:11434
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=0          # 0 = model default (bge-m3 = 1024)
#
# ── Option A2: 本机 ONNX embed server (无 Ollama 依赖, 与烘焙同模型同空间) ──
# 先导出一次模型: HF_ENDPOINT=https://hf-mirror.com python3 external/export_onnx.py
# 然后常驻服务:  python3 external/embed_server.py        # :18080
# EMBEDDING_BASE_URL=http://localhost:18080/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=model
# EMBEDDING_DIMENSIONS=0          # bge-m3 = 1024
#
# ── Option B: Zhipu remote (cloud) ──
# ⚠️ 与烘焙向量(bge-m3)不同空间, 语义检索会失配 — 不推荐, 仅供非 RAG 用途参考
# embedding-2: 1024 dims (no need to set DIMENSIONS)
# embedding-3 / embedding-3-pro: default 2048, MUST set DIMENSIONS=1024
#   to match the existing Qdrant collection (1024 dims).
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=your_zhipu_key
# EMBEDDING_MODEL=embedding-3-pro
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENABLED=true
# ↓ 必填: 与烘焙同模型 (推荐 Option A / A2), 留空 = 检索降级 keyword-only
EMBEDDING_BASE_URL=http://localhost:18080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=model
EMBEDDING_DIMENSIONS=0

# ── Cross-encoder rerank (RRF 融合后的精排层, 默认关闭) ──
# 对最终候选池 (2×KNOWLEDGE_TOP_K) 做一次 query-文档交叉打分并重排, 提升
# 进提示词的条目排序质量。需要一个 TEI 风格的 /rerank 服务, 例如:
#   docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:1.7 \
#     --model-id BAAI/bge-reranker-v2-m3
# 服务不可达/超时(2s)时自动退回 RRF 原序, 不会阻塞回答。
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3

# ── MariaDB: 业务库(可变数据) + 知识库(基础数据) ──
# 2026-10-02 起两者分容器:业务库 doctor_agent 挂持久卷,知识库 doctor_knowledge
# 由 doctor-agent-kb 镜像自带、不挂持久卷(镜像即数据)。
# MARIA_DB_* 只描述【业务库】实例;知识库要么在同一实例上(留空 KNOWLEDGE_DB_DSN,
# 由这些变量拼出),要么用 KNOWLEDGE_DB_DSN 指向独立实例(compose 即此模式)。
# 容器部署时业务库由应用自动建表;这里只需填连接信息。
MARIA_DB_ROOT_PASSWORD=changeme
MARIA_DB_HOST=localhost
MARIA_DB_PORT=3306
MARIA_DB_USER=root
MARIA_DB_PASSWORD=changeme
MARIA_DB_KNOWLEDGE_DB=doctor_knowledge
MARIA_DB_APP_DB=doctor_agent
# 知识库在独立实例时【必须】设置,否则应用会去业务实例上找一个空知识库。
# 设置后应用不再在业务实例上创建 doctor_knowledge。
# KNOWLEDGE_DB_DSN=root:changeme@tcp(kb-host:3306)/doctor_knowledge?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&interpolateParams=true
# APP_DB_DSN=root:changeme@tcp(localhost:3306)/doctor_agent?parseTime=true

# Safety
EMERGENCY_DETECTION_ENABLED=true
SCOPE_GUARD_ENABLED=true
POST_VERIFY_ENABLED=true

# Semantic claim verification (LLM-as-judge secondary check)
# POST_VERIFY_SEMANTIC=true        # enable claim-support verification
# POST_VERIFY_JUDGE_MODEL=          # optional cheaper judge model; empty = reuse main model

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=7071
# 对外可访问的根地址（落地页/分享链接里的绝对 URL 用它拼）；留空 = 按请求的
# Host 头推导。部署在域名 + 反代后面时设置，例如 https://doctor.example.com
PUBLIC_BASE_URL=
# /admin 控制台的初始口令（仅首次建 admin 用户时用到）。留空 = 启动时随机生成一个
# 128-bit 口令、只在那次启动打印一行 warn，所以不设也是安全默认（不再有固定的
# admin123）。注意没有改密接口：/admin/users/{id} 只有 GET/DELETE，口令记丢了只能
# 直接改业务库 users 表或删掉 admin 用户后带 ADMIN_PASSWORD 重启重建。
ADMIN_PASSWORD=

# Security (optional, recommended for public deployments)
# API_KEY=your_secret_token        # Bearer token required on /chat endpoints; empty = no auth
# CORS_ORIGINS=https://app.example.com,https://admin.example.com  # empty = allow all (*)
# RATE_LIMIT=120                   # max requests per IP per minute; 0 = unlimited (启动时会给出不限流告警)
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8  # 只有来自这些地址的请求才会被采信
                                    # X-Forwarded-For/X-Real-IP；留空 = 永远按 TCP
                                    # 对端地址限流（部署在 nginx/ LB 后必须设置，
                                    # 否则全体访客共用一个限流桶）
# 多用户部署：POST /login 用用户名密码换取 Bearer 令牌，/sessions、/family、
# /share 与 /chat 的会话都按登录用户隔离（未登录 = 原来的匿名单用户模式）。
# AUTH_SECRET=change-me-to-a-long-random-string   # 令牌 HMAC-SHA256 签名密钥；
                                    # 留空 = 每次启动随机生成，进程重启后所有令牌
                                    # 立即失效（安全但需要重新登录），多实例部署必须设置

# Session persistence (JSON snapshots; conversations survive restarts)
# SESSION_DIR=./sessions           # empty = in-memory sessions only
# 内存会话缓存的上限（有持久化 store 时空闲会话会被驱逐并在下次请求时自动载回）
# SESSION_IDLE_MINUTES=120         # 空闲多久后从内存驱逐；0 = 不按空闲驱逐
# MAX_ACTIVE_SESSIONS=500          # 内存中同时保留的会话数上限（LRU）；0 = 不限制

# Logging
# 日志默认写到 logs/doctor-agent.log（与 app 同目录），自动轮转：
# 单文件 10MB 上限、最多保留 7 天。docker compose 已挂载 ./logs:/app/logs。
LOG_LEVEL=warn
