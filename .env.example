# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Model selection
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent settings
MAX_TOKENS=4096
TEMPERATURE=0.3
MAX_HISTORY_TURNS=20

# Knowledge retrieval
KNOWLEDGE_TOP_K=5
KNOWLEDGE_RETRIEVAL_ENABLED=true

# Safety
EMERGENCY_DETECTION_ENABLED=true
SCOPE_GUARD_ENABLED=true
POST_VERIFY_ENABLED=true

# Semantic claim verification (LLM-as-judge secondary check)
# POST_VERIFY_SEMANTIC=true        # enable claim-support verification
# POST_VERIFY_JUDGE_MODEL=          # optional cheaper judge model; empty = reuse main model

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging
LOG_LEVEL=info
