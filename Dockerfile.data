# doctor-agent 知识库数据基础镜像(静态,极少变动)
#
# 仅包含 50 个 gz 知识库,供 app 容器在运行时通过 volume 挂载到 /opt/knowledge/gz。
# 这样源码改动只重建很小的 app 镜像,知识库层(本镜像)不动、不重烤。
#
# 构建: docker build -f Dockerfile.data -t doctor-agent-data:latest .
# 推送: docker push <你的仓库>/doctor-agent-data:latest

# syntax=docker/dockerfile:1

FROM alpine:3.20
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
    && apk add --no-cache ca-certificates
COPY internal/knowledge/gz /opt/knowledge/gz
