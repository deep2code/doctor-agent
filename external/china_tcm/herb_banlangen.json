{
  "name": "板蓝根",
  "name_pinyin": "banlangen",
  "name_latin": "Isatis indigotica Fort.",
  "category": "清热药",
  "properties": "苦，寒。归心、胃经。",
  "effects": "清热解毒，凉血利咽。",
  "indications": "温疫时毒，发热咽痛，温毒发斑，痄腮，烂喉丹痧，大头瘟疫，丹毒，痈肿。",
  "dosage": "9-15g。",
  "contraindications": "脾胃虚寒者慎用。",
  "source": "《中国药典》2020年版"
}