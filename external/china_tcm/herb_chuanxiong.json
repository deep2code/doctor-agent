{
  "name": "川芎",
  "name_pinyin": "chuanxiong",
  "name_latin": "Ligusticum chuanxiong Hort.",
  "category": "活血化瘀药",
  "properties": "辛，温。归肝、胆、心包经。",
  "effects": "活血行气，祛风止痛。",
  "indications": "血瘀气滞痛证，头痛，风湿痹痛，月经不调，经闭痛经，癥瘕腹痛，胸胁刺痛，跌打损伤。",
  "dosage": "3-10g。",
  "contraindications": "阴虚火旺、舌红口干者慎用。",
  "source": "《中国药典》2020年版"
}