{
  "name": "丹参",
  "name_pinyin": "danshen",
  "name_latin": "Salvia miltiorrhiza Bge.",
  "category": "活血化瘀药",
  "properties": "苦，微寒。归心、肝经。",
  "effects": "活血祛瘀，通经止痛，清心除烦，凉血消痈。",
  "indications": "瘀血阻滞之痛证，经闭痛经，癥瘕积聚，胸痹心痛，心腹疼痛，热痹疼痛，疮疡肿痛，心烦不眠。",
  "dosage": "10-15g。",
  "contraindications": "不宜与藜芦同用。",
  "source": "《中国药典》2020年版"
}