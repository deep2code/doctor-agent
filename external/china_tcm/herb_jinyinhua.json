{
  "name": "金银花",
  "name_pinyin": "jinyinhua",
  "name_latin": "Lonicera japonica Thunb.",
  "category": "清热药",
  "properties": "甘，寒。归肺、心、胃经。",
  "effects": "清热解毒，疏散风热。",
  "indications": "痈肿疔疮，喉痹，丹毒，热毒血痢，风热感冒，温病发热。",
  "dosage": "6-15g。",
  "contraindications": "脾胃虚寒及疮疡属阴证者慎用。",
  "source": "《中国药典》2020年版"
}