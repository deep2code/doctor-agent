 {
  "id": "elderly-osteoporosis-2011-1",
  "condition_zh": "骨质疏松症",
  "condition_en": "Osteoporosis",
  "category": "elderly_care",
  "diagnosis": {
   "clinical_features": [
    "疼痛、驼背、身高降低和骨折"
   ]
  },
  "risk_factors": [
   "老龄、女性绝经、母系家族史、低体重、性激素低下、吸烟、过度饮酒或咖啡、体力活动少、饮食中钙和/或维生素D缺乏、有影响骨代谢的疾病、应用影响骨代谢的药物"
  ],
  "prevention": [
   "均衡饮食、适量运动、增加日光照射"
  ],
  "treatment": [
   {
    "name": "药物治疗",
    "details": "抗骨吸收药物、促进骨形成药物以及一些多重机制的药物"
   }
  ],
  "when_to_seek_care": [
   "轻微碰撞或跌倒后伤到骨骼、连续3个月以上服用激素类药品、身高降低、过度饮酒、吸烟、腹泻、家族髋部骨折史、女士45岁前绝经、男士阳痿或缺乏性欲、连续12个月以上无月经（非怀孕期间）"
  ],
